---
layout: base.njk
title: Stories
---
<section class="page-header">
  <div class="wrap">
    <h1>Stories</h1>
    <p class="lede">Creative nonfiction from current and former students — personal narratives, essays, features and photo essays, published as they come in.</p>
  </div>
</section>

<section class="stories-grid wrap">
  {%- for story in collections.stories %}
  <a href="{{ story.url }}" class="story-card">
    {% if story.data.image %}
    <div class="ph-image {{ story.data.imageAspect or 'portrait' }}"><img src="{{ story.data.image }}" alt=""></div>
    {% else %}
    <div class="ph {{ story.data.imageAspect or 'portrait' }}"><span>{{ story.data.imageAspect | capitalize or 'Portrait' }} photograph</span></div>
    {% endif %}

    <h3>{{ story.data.title }}</h3>
    <p class="meta">{{ story.data.author }} · {{ story.data.date | readableDateShort }}</p>
  </a>
  {%- endfor %}
</section>
