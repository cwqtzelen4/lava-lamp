---
layout: base.njk
title: About
---
<section class="about-section wrap">
  <h1>About</h1>
  <p>{{ site.nameLine1 }} {{ site.nameLine2 }} is an independent student magazine at the American University in Bulgaria. We publish online year-round and in print each semester - stories, essays and photography made by students, about the place we're all temporarily from.</p>
  <p>We're not affiliated with any university office, and we like it that way. Nobody assigns our stories but us.</p>
</section>

<section class="team-section wrap">
  <div class="team-list">
    {%- for member in team.members %}
    {%- set authorRec = member.author | findAuthor(collections.authors) -%}
    <div class="team-member">
      {% if authorRec.data.photo %}
      <div class="ph-image square"><a href="{{ authorRec.url }}"><img src="{{ authorRec.data.photo }}" alt=""></a></div>
      {% else %}
      <div class="ph square"><span>Photo</span></div>
      {% endif %}
      <h3>{% if authorRec %}<a href="{{ authorRec.url }}">{{ member.name }}</a>{% else %}{{ member.name }}{% endif %}</h3>
      <p class="role">{{ member.role }}</p>
      <p>{{ member.bio }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

{% if collections.authors.length %}
<section class="authors-section wrap">
  <p class="eyebrow">Contributors</p>
  <div class="authors-grid">
    {%- for author in collections.authors %}
    <a href="{{ author.url }}" class="author-tile">
      {% if author.data.photo %}
      <div class="ph-image square"><img src="{{ author.data.photo }}" alt=""></div>
      {% else %}
      <div class="ph square"><span>Author photo</span></div>
      {% endif %}
      <h3>{{ author.data.name }}</h3>
      <p class="role">{{ author.data.role or "Author" }}</p>
    </a>
    {%- endfor %}
  </div>
</section>
{% endif %}
