---
layout: base.njk
title: null
---
{%- set recent = collections.stories -%}
{%- set latestIssue = collections.issues[0] -%}

<section class="recent-section">
  <div class="wrap">
    <div class="section-heading">
      <h2>Recent Stories</h2>
      <a href="/stories/" class="see-all">All Stories →</a>
    </div>
    <div class="recent-grid">
      {%- for story in recent %}
      {%- set authorRec = story.data.author | findAuthor(collections.authors) -%}
      <a href="{{ story.url }}" class="story-card">
        {% if story.data.image %}
        <div class="ph-image landscape"><img src="{{ story.data.image }}" alt=""></div>
        {% else %}
        <div class="ph landscape"><span>Landscape photograph</span></div>
        {% endif %}
        <h3>{{ story.data.title }}</h3>
        <p class="meta">{{ authorRec.data.name if authorRec else story.data.author }} · {{ story.data.date | readableDateShort }}</p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

{% if latestIssue %}
<section class="print-preview">
  <div class="wrap print-preview-grid">
    {% if latestIssue.data.cover %}
    <a href="{{ latestIssue.url }}" class="ph-image cover"><img src="{{ latestIssue.data.cover }}" alt=""></a>
    {% else %}
    <a href="{{ latestIssue.url }}" class="ph cover"><span>Cover</span></a>
    {% endif %}
    <div>
      <p class="eyebrow">In Print</p>
      <h2>Issue {{ latestIssue.data.number }} - {{ latestIssue.data.date | readableDateMonthYear }}</h2>
      <p>{{ latestIssue.data.description }}</p>
      <a href="/print/" class="text-link">Visit the Print Archive →</a>
    </div>
  </div>
</section>
{% endif %}
