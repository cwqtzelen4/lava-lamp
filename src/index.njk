---
layout: base.njk
title: null
---
{%- set recent = collections.stories -%}
{%- set latestIssue = collections.issues[0] -%}

<section class="recent-section">
  <div class="wrap">
    <div class="section-heading">
      <h2>Recent Stories</h2>
      <div class="search-wrap">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
          <line x1="10.4" y1="10.4" x2="14" y2="14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input type="search" id="story-search" class="search-input" placeholder="Search stories by title or author…" aria-label="Search stories">
      </div>
    </div>
    <div class="recent-grid">
      {%- for story in recent %}
      {%- set authorRec = story.data.author | findAuthor(collections.authors) -%}
      {%- set authorName = authorRec.data.name if authorRec else story.data.author -%}
      <a href="{{ story.url }}" class="story-card" data-search="{{ story.data.title }} {{ authorName }}">
        {% if story.data.image %}
        <div class="ph-image landscape"><img src="{{ story.data.image }}" alt=""></div>
        {% else %}
        <div class="ph landscape"><span>Landscape photograph</span></div>
        {% endif %}
        <h3>{{ story.data.title }}</h3>
        <p class="meta">{{ authorName }} · {{ story.data.date | readableDateShort }}</p>
      </a>
      {%- endfor %}
      <p id="search-empty" class="lede" hidden>No stories match your search.</p>
    </div>
  </div>
</section>
<script src="/search.js" defer></script>

{% if latestIssue %}
<section class="print-preview">
  <div class="wrap print-preview-grid">
    {% if latestIssue.data.cover %}
    <a href="{{ latestIssue.url }}" class="ph-image cover"><img src="{{ latestIssue.data.cover }}" alt=""></a>
    {% else %}
    <a href="{{ latestIssue.url }}" class="ph cover"><span>Cover</span></a>
    {% endif %}
    <div>
      <p class="eyebrow">In Print</p>
      <h2>Issue {{ latestIssue.data.number }} - {{ latestIssue.data.date | readableDateMonthYear }}</h2>
      <p>{{ latestIssue.data.description }}</p>
      <a href="/print/" class="text-link">Visit the Print Archive →</a>
    </div>
  </div>
</section>
{% endif %}
