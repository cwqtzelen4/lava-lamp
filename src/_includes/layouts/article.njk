---
layout: base.njk
---
{%- set authorRec = author | findAuthor(collections.authors) -%}
<section class="article-head wrap">
  <div class="meta-row">
    <span>{{ date | readableDate }}</span>
  </div>
  <h1>{{ title }}</h1>
  {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
  <p class="byline">By <strong>{% if authorRec %}<a href="{{ authorRec.url }}">{{ authorRec.data.name }}</a>{% else %}{{ author }}{% endif %}</strong></p>
</section>

<figure class="article-hero wrap">
  {% if image %}
  <div class="ph-image wide"><img src="{{ image }}" alt=""></div>
  {% else %}
  <div class="ph wide"><span>Featured photograph - wide</span></div>
  {% endif %}
  {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
</figure>

<article class="article-body wrap">
{{ content | safe }}
</article>

{% if authorRec %}
<section class="author-card wrap">
  <a href="{{ authorRec.url }}" class="author-card-photo">
    {% if authorRec.data.photo %}
    <div class="ph-image square"><img src="{{ authorRec.data.photo }}" alt=""></div>
    {% else %}
    <div class="ph square"><span>Author photo</span></div>
    {% endif %}
  </a>
  <div>
    {%- set roleLabels = { "Author": "Written by", "Illustrator": "Illustrated by", "Photographer": "Photographed by" } %}
    <p class="eyebrow">{{ roleLabels[authorRec.data.role] or "Written by" }}</p>
    <h3><a href="{{ authorRec.url }}">{{ authorRec.data.name }}</a></h3>
    <p>{{ authorRec.data.bio }}</p>
  </div>
</section>
{% endif %}
