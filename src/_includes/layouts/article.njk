---
layout: base.njk
---
{%- set authorRec = author | findAuthor(collections.authors) -%}
<section class="article-head wrap">
  <div class="meta-row">
    <span>{{ date | readableDate }}</span>
  </div>
  <h1>{{ title }}</h1>
  {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
  <p class="byline">By <strong>{% if authorRec %}<a href="{{ authorRec.url }}">{{ authorRec.data.name }}</a>{% else %}{{ author }}{% endif %}</strong></p>
</section>

{#- the picture above the text is separate from the cover image used in galleries: it can be switched off or replaced -#}
{%- set topPicture = topImage or (image if showTopImage else "") -%}
{% if topPicture %}
<figure class="article-hero wrap">
  <div class="ph-image wide"><img src="{{ topPicture }}" alt=""></div>
  {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
</figure>
{% endif %}

<article class="article-body wrap">
{{ content | safe }}
</article>

{#- credits under the text: writer first, then illustrator, then photographer -#}
{%- set illustratorRec = illustrator | findAuthor(collections.authors) -%}
{%- set photographerRec = photographer | findAuthor(collections.authors) -%}
{%- set credits = [] -%}
{%- if authorRec %}{% set _a = credits.push({ label: "Written by", rec: authorRec }) %}{% endif -%}
{%- if illustratorRec %}{% set _i = credits.push({ label: "Illustrated by", rec: illustratorRec }) %}{% endif -%}
{%- if photographerRec %}{% set _p = credits.push({ label: "Photographed by", rec: photographerRec }) %}{% endif -%}
{% if credits.length %}
<section class="author-card wrap">
  <div class="author-card-inner">
    {%- for credit in credits %}
    <div class="author-card-row">
      <a href="{{ credit.rec.url }}" class="author-card-photo">
        {% if credit.rec.data.photo %}
        <div class="ph-image square"><img src="{{ credit.rec.data.photo }}" alt=""></div>
        {% else %}
        <div class="ph square"><span>Photo</span></div>
        {% endif %}
      </a>
      <div>
        <p class="eyebrow">{{ credit.label }}</p>
        <h3><a href="{{ credit.rec.url }}">{{ credit.rec.data.name }}</a></h3>
        <p>{{ credit.rec.data.bio | firstWords(7) }}</p>
      </div>
    </div>
    {%- endfor %}
  </div>
</section>
{% endif %}
