---
layout: base.njk
---
{%- set authorRec = author | findAuthor(collections.authors) -%}
{%- set illustratorRec = illustrator | findAuthor(collections.authors) -%}
{%- set photographerRec = photographer | findAuthor(collections.authors) -%}
{%- set audioRec = audio | findAuthor(collections.authors) -%}
<section class="article-head wrap">
  <div class="meta-row">
    <span>{{ date | readableDate }}</span>
  </div>
  <h1>{{ title }}</h1>
  {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
  <p class="byline">Written by <strong>{% if authorRec %}<a href="{{ authorRec.url }}">{{ authorRec.data.name }}</a>{% else %}{{ author }}{% endif %}</strong></p>
  {%- if illustratorRec %}
  <p class="byline">Illustrations by <strong><a href="{{ illustratorRec.url }}">{{ illustratorRec.data.name }}</a></strong></p>
  {%- endif %}
  {%- if photographerRec %}
  <p class="byline">Photography by <strong><a href="{{ photographerRec.url }}">{{ photographerRec.data.name }}</a></strong></p>
  {%- endif %}
  {%- if audioRec %}
  <p class="byline">Audio by <strong><a href="{{ audioRec.url }}">{{ audioRec.data.name }}</a></strong></p>
  {%- endif %}
</section>

{#- the picture above the text is separate from the cover image used in galleries: it can be switched off or replaced -#}
{%- set topPicture = topImage or (image if showTopImage else "") -%}
{% if topPicture %}
<figure class="article-hero wrap">
  <div class="ph-image wide"><img src="{{ topPicture }}" alt=""></div>
  {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
</figure>
{% endif %}

<article class="article-body wrap">
{{ content | safe }}
{#- end-of-article spiral, added to every story automatically -#}
