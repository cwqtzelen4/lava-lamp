{#- people under the text: writer first, then illustrator, photographer, audio. Each person appears only once, however many roles they have; the roles are already named at the top. -#}
{%- set credits = [] -%}
{%- set seen = [] -%}
{%- for person in [authorRec, illustratorRec, photographerRec, audioRec] %}
{%- if person and (person.url not in seen) %}{% set _s = seen.push(person.url) %}{% set _c = credits.push(person) %}{% endif %}
{%- endfor %}
{% if credits.length %}
<section class="author-card wrap">
  <div class="author-card-inner">
    <p class="eyebrow author-card-title">About the creator{% if credits.length > 1 %}s{% endif %}</p>
    {%- for credit in credits %}
    <div class="author-card-row">
      <a href="{{ credit.url }}" class="author-card-photo">
        {% if credit.data.photo %}
        <div class="ph-image square"><img src="{{ credit.data.photo }}" alt=""></div>
        {% else %}
        <div class="ph square"><span>Photo</span></div>
        {% endif %}
      </a>
      <div>
        <h3><a href="{{ credit.url }}">{{ credit.data.name }}</a></h3>
        <p>{{ credit.data.shortBio or (credit.data.bio | firstWords(7)) }}</p>
      </div>
    </div>
    {%- endfor %}
  </div>
</section>
{% endif %}
