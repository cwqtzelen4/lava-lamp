<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} - {{ site.nameLine1 }} {{ site.nameLine2 }}{% elif name %}{{ name }} - {{ site.nameLine1 }} {{ site.nameLine2 }}{% else %}{{ site.nameLine1 }} {{ site.nameLine2 }} - {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="icon" type="image/jpeg" href="/favicon.jpg">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<header class="site-header">
  <div class="wrap">
    <a href="/" class="logo">
      <img src="{{ site.logo }}" alt="{{ site.nameLine1 }} {{ site.nameLine2 }}" class="logo-mark">
      {% if site.statementLine1 or site.statementLine2 %}
      <span class="logo-statement">
        {% if site.statementLine1 %}<span class="statement-line">{{ site.statementLine1 }}</span>{% endif %}
        {% if site.statementLine2 %}<span class="statement-line">{{ site.statementLine2 }}</span>{% endif %}
      </span>
      {% endif %}
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false"><span></span></button>
    <nav class="main-nav">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <img src="{{ site.logo }}" alt="{{ site.nameLine1 }} {{ site.nameLine2 }}" class="foot-mark">
    <span class="foot-meta">{{ site.footerMeta }}</span>
    <div class="foot-links">
      <a href="/about/">About</a>
      <a href="mailto:{{ site.contactEmail }}" class="contact-open">Contact</a>
    </div>
  </div>
</footer>

<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
  <button type="button" class="contact-close" aria-label="Close">&times;</button>
  <h2 id="contact-title">Contact us</h2>
  <p class="contact-intro">Write to us at <strong>{{ site.contactEmail }}</strong>. Choose where you want to write your email:</p>
  {%- set mailSubject = (site.nameLine1 + ' ' + site.nameLine2 + ' magazine') | urlencode %}
  <div class="contact-choices">
    <a class="submit-btn contact-choice" href="https://mail.google.com/mail/?view=cm&fs=1&to={{ site.contactEmail | urlencode }}&su={{ mailSubject }}" target="_blank" rel="noopener">Open in Gmail</a>
    <a class="submit-btn contact-choice" href="https://outlook.office.com/mail/deeplink/compose?to={{ site.contactEmail | urlencode }}&subject={{ mailSubject }}" target="_blank" rel="noopener">Open in Outlook</a>
  </div>
</dialog>

<script src="/nav.js"></script>
<script src="/contact.js" defer></script>
</body>
</html>
