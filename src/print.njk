---
layout: base.njk
title: Print
---
<section class="page-header">
  <div class="wrap">
    <h1>Print</h1>
    <p class="lede">Every issue, in order. Each one is free to read here, and free to download in full.</p>
  </div>
</section>

<section class="issues-list wrap">
  <div class="issue-grid">
    {%- for issue in collections.issues %}
    <article class="issue-tile">
      {% if issue.data.cover %}
      <div class="ph-image cover"><img src="{{ issue.data.cover }}" alt=""></div>
      {% else %}
      <div class="ph cover"><span>Cover — Issue {{ issue.data.number }}</span></div>
      {% endif %}
      <p class="eyebrow">Issue {{ issue.data.number }} · {{ issue.data.date | readableDateMonthYear }}</p>
      <h2>{{ issue.data.title }}</h2>
      <p>{{ issue.data.description }}</p>
      <div class="tile-links">
        {% if issue.data.pdf %}<a href="{{ issue.data.pdf }}" class="download-link"><span class="arrow">↓</span> Download PDF</a>{% endif %}
      </div>
    </article>
    {%- endfor %}
  </div>
</section>
