---
permalink: _redirects
eleventyExcludeFromCollections: true
---
{%- for a in collections.authors %}
{%- set oldUrl = "/authors/" + a.data.authorSlug + "/" %}
{%- if a.url != oldUrl %}
{{ oldUrl }} {{ a.url }} 301
{%- endif %}
{%- set writerUrl = "/writers/" + a.data.authorSlug + "/" %}
{%- if a.url != writerUrl %}
{{ writerUrl }} {{ a.url }} 301
{%- endif %}
{%- endfor %}
